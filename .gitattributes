# Line endings are pinned, not host-default: the Termux runtime script is read
# straight out of the APK by bash, and the driver ZIP must stay byte-identical.
* text=auto eol=lf
*.sh text eol=lf
*.kt text eol=lf
*.c text eol=lf
*.h text eol=lf
*.xml text eol=lf
*.kts text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.zip binary
*.png binary
*.jar binary
